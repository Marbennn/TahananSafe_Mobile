{
  "expo": {
    "name": "TahananSafe",
    "slug": "tahanansafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/Logo1.png",
    "splash": {
      "image": "./assets/splash1.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to login securely.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Allow TahananSafe to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow TahananSafe to use the microphone."
      },
      "bundleIdentifier": "com.angelgeloo0918.firstproject"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.angelgeloo0918.firstproject",
      "googleServicesFile": "./android/app/google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow TahananSafe to use the microphone.",
          "speechRecognitionPermission": "Allow TahananSafe to use speech recognition."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "06c77f92-0898-48a9-984e-ed13482ced03"
      }
    },
    "owner": "angelgeloo0918"
  }
}
