{
  "expo": {
    "name": "TahananSafe",
    "slug": "firstproject",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/Logo1.png",
    "splash": {
      "image": "./assets/splash1.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to login securely.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.angelgeloo0918.firstproject"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.angelgeloo0918.firstproject",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TahananSafe to use your camera for report message photos and videos.",
          "microphonePermission": "Allow TahananSafe to use your microphone while recording report message videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow TahananSafe to use the microphone.",
          "speechRecognitionPermission": "Allow TahananSafe to use speech recognition."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#1A3C6E"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d1348907-6805-42cd-bd5c-e86fef9033f7"
      }
    }
  }
}
